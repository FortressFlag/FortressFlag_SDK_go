        { "conditions": [ { "tagKey": "appVersion", "operator": "semver_gte", "value": "2.0" } ], "serve": false }
      ] },
      "input": { "contextKey": "user-1", "flagKey": "dark-mode", "tags": { "appVersion": "2.5" } },
      "expected": { "value": false }
    },
